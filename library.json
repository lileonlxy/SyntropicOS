{
  "name": "SyntropicOS",
  "version": "2026.8.0",
  "description": "Zero-overhead C99 bare-metal framework & cooperative OS. Features protothreads, zero heap allocation, BLE host stack, OCPP 2.1 EVSE, audio DSP/SBC, USB MIDI/MSC, FOC motor control, EtherCAT, CANopen, UDS, and WireGuard.",
  "keywords": [
    "protothreads",
    "cooperative-rtos",
    "coroutine",
    "zero-heap",
    "bare-metal",
    "ble-bluetooth",
    "ocpp-evse",
    "audio-dsp",
    "usb-msc",
    "ethercat",
    "canopen",
    "j1939",
    "modbus",
    "wireguard",
    "nmea0183",
    "smbus",
    "pmbus",
    "foc-motor-control",
    "kalman-filter",
    "svpwm",
    "biquad-filter",
    "fixed-point-math",
    "stm32",
    "rp2040"
  ],
  "authors": [
    {
      "name": "Charles Galant",
      "email": "cgalant@gmail.com",
      "url": "https://github.com/outlookhazy"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/outlookhazy/SyntropicOS.git"
  },
  "homepage": "https://outlookhazy.github.io/SyntropicOS/",
  "license": "Apache-2.0",
  "frameworks": "*",
  "platforms": "*",
  "headers": [
    "SyntropicOS.h",
    "syntropic/syntropic.h"
  ],
  "build": {
    "flags": [
      "-Isrc",
      "-Isrc/syntropic"
    ],
    "srcFilter": [
      "+<*>",
      "-<port/ch32v307/*>",
      "-<port/stm32f4/*>"
    ]
  }
}
